{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "raw",
    "source": "E:\\GithubRepositories\\output.six",
    "width": 40,
    "height": 30,
    "padding": {
      "top": 1,
      "left": 0,
      "right": 5
    },
    "printRemaining": true
  },

  "display": {
    "separator": " ",
    "color": {
      "keys": "#8BD49C",
      "title": "#9BE5D8",
      "output": "#D8DEE9",
      "separator": "#525A6B"
    },
    "key": {
      "width": 15
    },
    "bar": {
      "width": 13,
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "border": {
        "left": "[",
        "right": "]"
      },
      "color": {
        "elapsed": "#FE3028",
        "total": "#454D5D",
        "border": "#626B7D"
      }
    },
    "percent": {
      "type": ["num"],
      "color": {
        "green": "#8BD49C",
        "yellow": "#E7C787",
        "red": "#E58C9B"
      }
    },
    "temp": {
      "green": 60,
      "yellow": 80,
      "color": {
        "green": "#8BD49C",
        "yellow": "#E7C787",
        "red": "#E58C9B"
      }
    }
  },

  "modules": [
    {
      "type": "title",
      "key": " ",
      "format": "{##D8DEE9}Hey, {##FE3028}{user-name}{#}"
    },
    "break",

    {
      "type": "custom",
      "format": "{##525A6B}┌────────────────{##FE3028} Hardware {##525A6B}────────────────┐{#}"
    },
    {
      "type": "host",
      "key": "├─ PC",
      "keyColor": "#FE3028",
      "format": "{name} // {version}"
    },
    {
      "type": "cpu",
      "key": "├─ CPU",
      "keyColor": "#FE3028",
      "temp": true,
      "format": "{name} ({cores-physical}C / {cores-logical}T){?freq-max} @ {freq-max}{?}{?temperature} // {temperature}{?}"
    },
    {
      "type": "gpu",
      "key": "├─ GPU",
      "keyColor": "#FE3028",
      "temp": true,
      "format": "{name} [{type}] {?dedicated-total}// {dedicated-total}{?} {?temperature}// {temperature}{?}"
    },
    {
      "type": "memory",
      "key": "├─ RAM",
      "keyColor": "#FE3028",
      "format": "{used} / {total} {percentage-bar} {percentage}",
      "percent": {
        "type": ["bar", "num"]
      }
    },
    {
      "type": "swap",
      "key": "├─ SWAP",
      "keyColor": "#FE3028",
      "format": "{used} / {total} {percentage-bar} {percentage}",
      "percent": {
        "type": ["bar", "num"]
      }
    },
    {
      "type": "disk",
      "key": "├─ DRIVE",
      "keyColor": "#FE3028",
      "format": "{mountpoint} {size-used} / {size-total} {size-percentage-bar} {size-percentage}",
      "percent": {
        "type": ["bar", "num"]
      }
    },
    {
      "type": "display",
      "key": "├─ DISPLAY",
      "keyColor": "#FE3028",
      "format": "{width}x{height} @ {refresh-rate} Hz [{type}]"
    },
    {
      "type": "battery",
      "key": "└─ BATTERY",
      "keyColor": "#FE3028",
      "format": "{capacity} // {status} {?time-formatted}// {time-formatted}{?}"
    },
    {
      "type": "custom",
      "format": "{##525A6B}└──────────────────────────────────────────┘{#}"
    },
    "break",

    {
      "type": "custom",
      "format": "{##525A6B}┌────────────────{##FE3028} Software {##525A6B}────────────────┐{#}"
    },
    {
      "type": "os",
      "key": "├─ OS",
      "keyColor": "#FE3028",
      "format": "{pretty-name} [{arch}]"
    },
    {
      "type": "wm",
      "key": "├─ WM",
      "keyColor": "#FE3028",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "shell",
      "key": "├─ SHELL",
      "keyColor": "#FE3028",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": "├─ TERMINAL",
      "keyColor": "#FE3028",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "packages",
      "key": "├─ PACKAGES",
      "keyColor": "#FE3028",
      "format": "{?choco}{choco} choco · {?}{?scoop-user}{scoop-user} scoop{?}"
    },
    {
      "type": "locale",
      "key": "└─ LOCALE",
      "keyColor": "#FE3028",
      "format": "{result}"
    },
    {
      "type": "custom",
      "format": "{##525A6B}└──────────────────────────────────────────┘{#}"
    },
    "break",

    {
      "type": "custom",
      "format": "{##525A6B}┌─────────────────{##FE3028} Session {##525A6B}────────────────┐{#}"
    },
    {
      "type": "users",
      "key": "├─ LOGIN",
      "keyColor": "#FE3028",
      "format": "{name} // {login-time}",
      "myselfOnly": true
    },
    {
      "type": "sound",
      "key": "├─ AUDIO",
      "keyColor": "#FE3028",
      "format": "{name}"
    },
    {
      "type": "localip",
      "key": "└─ LOCAL IP",
      "keyColor": "#FE3028",
      "format": "{ipv4} // {ifname}",
      "showIpv4": true,
      "showIpv6": false,
      "showLoop": false
    },
    {
      "type": "custom",
      "format": "{##525A6B}└──────────────────────────────────────────┘{#}"
    },
    "break",

    {
      "type": "custom",
      "format": "{##525A6B}┌──────────────{##FE3028} Uptime / Date {##525A6B}──────────────┐{#}"
    },
    {
      "type": "uptime",
      "key": "├─ UPTIME",
      "keyColor": "#FE3028",
      "format": "{formatted}"
    },
    {
      "type": "datetime",
      "key": "└─ DATE",
      "keyColor": "#FE3028",
      "format": "{year}-{month-pretty}-{day-pretty} {hour-pretty}:{minute-pretty}:{second-pretty}"
    },
    {
      "type": "custom",
      "format": "{##525A6B}└──────────────────────────────────────────┘{#}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 1
    }
  ]
}
